# =====================================================================
# StyleVAR .gitignore
# =====================================================================

# ---- Python bytecode / IDE / OS ----
*.pyc
*.swp
**/__pycache__/**
**/.ipynb_checkpoints/**
.DS_Store
.idea/*
.vscode/*

# ---- Artifacts (checkpoints, logs, outputs) ----
ckpt/
Output/
local_output*/
grpo_output*/
grpo_outputs/
log/
logs/
tb*/
img*/
samples/
eval_out*/
pilot_results/
pilot_out*/
_vis_cached/
_auto_*/
wandb/
llava/

# ---- Data ----
data/
data_check.py
split_data.py
split_omnistyle.py
prepare_data.py
prepare_imagepulse.py
extract_wikiart.py
extract_clean_ckpt.py
DATA_STRUCTURE.md

# ---- Binaries / large files ----
*.pth
*.pth.tar
*.ckpt
*.log
*.tar.gz
*.zip
*.whl
*.pdf
*.ipynb

# ---- Text artifacts (keep requirements.txt) ----
*.txt
!requirements.txt

# ---- DreamSim accidental downloads ----
models/pretrained.zip
models/checkpoints/
models/ensemble_lora/
models/facebookresearch_dino_main/
models/dino_vitb16_pretrain.pth
models/clip_vitb16_pretrain.pth.tar
models/open_clip_vitb16_pretrain.pth.tar
models/trusted_list

# ---- One-off / setup / download scripts ----
download_*.sh
setup_env*.sh
download_ckpt.sh

# ---- Infra scripts we don't version (old VAR repo deps) ----
dist.py
PROJECT_STRUCTURE.md

# ---- Research-side scripts (pilots, tests, merge tools) ----
pilot_*.py
run_pilots.sh
test_*.py
verify_*.py
test_dependency.py

# ---- Deprecated / legacy run scripts ----
run_grpo.sh
run_grpo_v4.sh
run_train.sh
run_train_v2.sh

# ---- Ad-hoc misc artifacts ----
archive.tar.gz
quick_infer.ipynb
grpo_infer_results_comparison.png
infer_results.png
style_strength_sweep.png
"midterm report"/
reference/
